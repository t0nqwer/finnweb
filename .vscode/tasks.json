{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync tasks to Google Sheet (watch)",
      "type": "shell",
      "command": "pnpm",
      "args": ["sync:tasks:watch"],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    }
  ]
}
