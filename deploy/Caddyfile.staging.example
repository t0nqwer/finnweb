# Replace staging.example.com with your test domain.
# This assumes:
# - Next.js web runs on 127.0.0.1:3000
# - NestJS API runs on 127.0.0.1:4000

staging.example.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle /docs* {
		reverse_proxy 127.0.0.1:4000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
